# Real API integration mode — flips every lib/api/* swap layer from mock to Spring Boot.
# Set to "false" (the literal string) to hit the real backend. Anything else (or unset) = mock.
NEXT_PUBLIC_USE_MOCK=false

# Spring Boot backend base URL (the axios client appends /api paths to this)
NEXT_PUBLIC_API_URL=http://localhost:8080/api
